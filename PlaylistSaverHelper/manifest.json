{
  "manifest_version": 3,
  "name": "Playlist Helper",
  "version": "1.0",

  "permissions": [
  "scripting",
  "activeTab",
  "cookies"
],
"host_permissions": [
  "*://*.youtube.com/*"
],

  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "openPLKey": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "Launch PlaylistSaver"
    }
  }
}